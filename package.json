{
  "name": "gpool",
  "version": "0.1.71",
  "private": true,
  "description": "Real-time football pool management platform",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "node ./scripts/prepare-husky.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \"docker/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"scripts/**/*.json\" \"docs/**/*.md\" \"README.md\" \"CHANGELOG.md\" \"package.json\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \"docker/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"scripts/**/*.json\" \"docs/**/*.md\" \"README.md\" \"CHANGELOG.md\" \"package.json\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "typecheck": "npm run typecheck -w @gpool/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov -w @gpool/api -- --passWithNoTests",
    "test:secrets:gitleaks": "./scripts/precommit-gitleaks.sh",
    "ci:integration:local": "./scripts/precommit-integration-e2e.sh",
    "ci:quality:local": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:cov && npm run test -w @gpool/web",
    "precommit:checks": "npm run test:secrets:gitleaks && npm run ci:quality:local && npm run ci:integration:local",
    "local:up": "bash ./scripts/local-stack-up.sh",
    "local:dev": "bash ./scripts/local-stack-dev.sh",
    "local:down": "bash ./scripts/local-stack-down.sh",
    "local:reset": "bash ./scripts/local-stack-reset.sh",
    "local:token": "bash ../platform-ops/scripts/provision-local-app-token.sh gpool",
    "audit": "npm audit --audit-level=high",
    "audit:prod:gate": "node ./scripts/audit-prod-gate.mjs",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "contract:gen:web": "node ./scripts/generate-api-contract.mjs",
    "i18n:push:local": "node scripts/i18n-sync-local.mjs --once --workspace @gpool/web",
    "i18n:watch:local": "node scripts/i18n-sync-local.mjs --watch --workspace @gpool/web"
  },
  "overrides": {
    "multer": "2.3.0",
    "@grpc/proto-loader": {
      "protobufjs": "7.6.5"
    },
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    },
    "gaxios": "7.3.0",
    "postcss": "8.5.27",
    "sharp": "0.35.4",
    "nanoid": "6.0.1",
    "js-yaml": "5.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "gcp-metadata": "9.0.3",
    "next": "^16.3.4"
  }
}
