{
  "name": "@gpool/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint --no-cache",
    "typecheck": "tsc --noEmit",
    "i18n:pull": "node ./scripts/i18n-pull.mjs",
