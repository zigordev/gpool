    "test": "vitest run",
    "clean": "rm -rf .next",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "flag-icons": "^7.5.0",
    "jszip": "^3.10.1",
    "next": "^15.5.25",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@tolgee/cli": "2.20.0",
    "@types/node": "^20.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.1.3",
    "vitest": "^3.2.4"
  }
}
