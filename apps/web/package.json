    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.18.1",
    "design-system": "github:zigordev/design-system#v0.1.46",
    "flag-icons": "^7.5.0",
    "jszip": "^3.10.2",
